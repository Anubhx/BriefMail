{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "BriefMail Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "primary": { "value": "#FF6B00", "type": "color", "description": "Vibrant International Orange for primary CTAs and urgency indicators" },
      "secondary": { "value": "#FF8933", "type": "color", "description": "Monochromatic light orange for interactive hover, focus, and pill highlights" },
      "subtle": { "value": "rgba(255, 107, 0, 0.12)", "type": "color", "description": "Low-opacity orange container fill" },
      "glow": { "value": "rgba(255, 107, 0, 0.35)", "type": "color", "description": "Focus ring and active aura" }
    },
    "neutral": {
      "bg-base": { "value": "#0B1120", "type": "color", "description": "Deepest canvas background" },
      "bg-surface": { "value": "#0F172A", "type": "color", "description": "Dominant neutral surface canvas" },
      "bg-surface-elevated": { "value": "#1E293B", "type": "color", "description": "Surface level 1 for cards and items" },
      "bg-surface-overlay": { "value": "#334155", "type": "color", "description": "Surface level 2 for dropdowns and popovers" },
      "border-subtle": { "value": "rgba(248, 250, 252, 0.08)", "type": "color", "description": "Hairline card and list dividers" },
      "border-strong": { "value": "rgba(248, 250, 252, 0.16)", "type": "color", "description": "Interactive and hover border strokes" }
    },
    "text": {
      "primary": { "value": "#F8FAFC", "type": "color", "description": "Crisp white text for titles, subjects, and headers" },
      "secondary": { "value": "#CBD5E1", "type": "color", "description": "High-legibility text for body copy and descriptions" },
      "muted": { "value": "#94A3B8", "type": "color", "description": "Secondary metadata, timestamps, and snippets" },
      "disabled": { "value": "#475569", "type": "color", "description": "Inactive text and icons" }
    },
    "semantic": {
      "success": { "value": "#10B981", "type": "color" },
      "success-subtle": { "value": "rgba(16, 185, 129, 0.12)", "type": "color" },
      "error": { "value": "#EF4444", "type": "color" },
      "error-subtle": { "value": "rgba(239, 68, 68, 0.12)", "type": "color" },
      "warning": { "value": "#F59E0B", "type": "color" },
      "warning-subtle": { "value": "rgba(245, 158, 11, 0.12)", "type": "color" },
      "info": { "value": "#38BDF8", "type": "color" },
      "info-subtle": { "value": "rgba(56, 189, 248, 0.12)", "type": "color" }
    }
  },
  "typography": {
    "fontFamilies": {
      "ui": { "value": "var(--font-plus-jakarta)", "type": "fontFamily" },
      "body": { "value": "var(--font-satoshi)", "type": "fontFamily" },
      "mono": { "value": "var(--font-jetbrains-mono)", "type": "fontFamily" }
    },
    "fontSizes": {
      "xs": { "value": "0.75rem", "type": "dimension" },
      "sm": { "value": "0.875rem", "type": "dimension" },
      "base": { "value": "0.9375rem", "type": "dimension" },
      "md": { "value": "1.0625rem", "type": "dimension" },
      "lg": { "value": "1.25rem", "type": "dimension" },
      "xl": { "value": "1.5rem", "type": "dimension" },
      "2xl": { "value": "1.875rem", "type": "dimension" }
    },
    "fontWeights": {
      "regular": { "value": 400, "type": "fontWeight" },
      "medium": { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold": { "value": 700, "type": "fontWeight" }
    },
    "lineHeights": {
      "none": { "value": 1.0, "type": "dimension" },
      "tight": { "value": 1.25, "type": "dimension" },
      "snug": { "value": 1.4, "type": "dimension" },
      "normal": { "value": 1.6, "type": "dimension" }
    },
    "letterSpacing": {
      "tighter": { "value": "-0.03em", "type": "dimension" },
      "tight": { "value": "-0.015em", "type": "dimension" },
      "normal": { "value": "0em", "type": "dimension" },
      "wide": { "value": "0.04em", "type": "dimension" }
    }
  },
  "spacing": {
    "1": { "value": "4px", "type": "dimension" },
    "2": { "value": "8px", "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "5": { "value": "20px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "8": { "value": "32px", "type": "dimension" },
    "10": { "value": "40px", "type": "dimension" },
    "12": { "value": "48px", "type": "dimension" },
    "16": { "value": "64px", "type": "dimension" }
  },
  "borderRadius": {
    "sm": { "value": "6px", "type": "dimension" },
    "md": { "value": "8px", "type": "dimension" },
    "lg": { "value": "12px", "type": "dimension" },
    "xl": { "value": "16px", "type": "dimension" },
    "full": { "value": "9999px", "type": "dimension" }
  },
  "shadow": {
    "elevation-0": { "value": "none", "type": "shadow" },
    "elevation-1": {
      "value": "0 1px 2px 0 rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(248, 250, 252, 0.05)",
      "type": "shadow"
    },
    "elevation-2": {
      "value": "0 4px 12px -2px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(248, 250, 252, 0.08)",
      "type": "shadow"
    },
    "elevation-3": {
      "value": "0 12px 32px -4px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(248, 250, 252, 0.12)",
      "type": "shadow"
    },
    "glow-brand": {
      "value": "0 0 20px -2px rgba(255, 107, 0, 0.35)",
      "type": "shadow"
    }
  }
}