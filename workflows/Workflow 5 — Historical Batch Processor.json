{
  "name": "AdvancedMail — 05 Historical Batch Processor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "id": "hourly-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/batch/active-jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "get-active-jobs",
      "name": "Get Active Batch Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.jobs_count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "has-jobs",
      "name": "Active Jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      },
      "id": "split-jobs",
      "name": "Split Per Job",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/batch/process-chunk",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.id }}\",\n  \"chunk_size\": 20\n}",
        "options": { "timeout": 120000 }
      },
      "id": "process-chunk",
      "name": "Process Chunk (20 emails)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "cooldown",
      "name": "Cooldown 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/batch/update-progress",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $('Split Per Job').item.json.id }}\",\n  \"processed\": {{ $json.processed_this_chunk }},\n  \"next_page_token\": \"{{ $json.next_page_token }}\",\n  \"is_complete\": {{ $json.is_complete }}\n}",
        "options": {}
      },
      "id": "update-progress",
      "name": "Update Job Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "no-jobs",
      "name": "No Active Jobs",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 420]
    }
  ],
  "connections": {
    "Every Hour": { "main": [[{ "node": "Get Active Batch Jobs", "type": "main", "index": 0 }]] },
    "Get Active Batch Jobs": { "main": [[{ "node": "Active Jobs?", "type": "main", "index": 0 }]] },
    "Active Jobs?": {
      "main": [
        [{ "node": "Split Per Job", "type": "main", "index": 0 }],
        [{ "node": "No Active Jobs", "type": "main", "index": 0 }]
      ]
    },
    "Split Per Job": { "main": [[{ "node": "Process Chunk (20 emails)", "type": "main", "index": 0 }]] },
    "Process Chunk (20 emails)": { "main": [[{ "node": "Cooldown 5s", "type": "main", "index": 0 }]] },
    "Cooldown 5s": { "main": [[{ "node": "Update Job Progress", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true },
  "tags": [{ "name": "advanced-mail" }],
  "active": true
}